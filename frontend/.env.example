# Frontend environment. Copy to `.env.local` if you need to override a value.
#
# Mock API: serves /auth/* from memory so the authentication screens can be
# explored before the backend endpoints exist. It is always disabled in a
# production build, and the UI shows a visible banner while it is on.
NEXT_PUBLIC_USE_MOCKS=false

# Express API origin for local development. Leave unset to use a same-origin /api/v1 proxy.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
