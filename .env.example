# Copy to .env locally. Never commit the filled copy.
# Values below are placeholders only.

# Runtime
NODE_ENV=development
LOG_LEVEL=info
# mock keeps runtime operations simulated; iaas is only for an approved environment.
RUNTIME_MODE=mock

# Listeners (internal only; Traefik is the public entry point)
API_PORT=3001
WEB_PORT=3000
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Database (Server 1 or local dev container)
DATABASE_URL=mysql://<DB_USER>:<DB_PASSWORD>@127.0.0.1:3306/ogulix_paas

# Local compose-only credentials used by infrastructure/docker/compose.dev.yml
MARIADB_DATABASE=ogulix_paas
MARIADB_USER=<DB_USER>
MARIADB_PASSWORD=<DB_PASSWORD>
MARIADB_ROOT_PASSWORD=<ROOT_PASSWORD>

# Queue
REDIS_URL=redis://127.0.0.1:6379

# Sessions
SESSION_COOKIE_NAME=ogulix_session
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=24
REGISTRATION_MODE=closed

# Application-level encryption key for environment variables.
# Base64-encoded 32 random bytes. Generate locally, never reuse a sample.
ENV_ENCRYPTION_KEY=<BASE64_32_BYTE_KEY>

# Local seed only. The admin password comes from the environment and is never
# hardcoded. Run `npm run db:seed` after migrations.
SEED_ADMIN_EMAIL=<ADMIN_EMAIL>
SEED_ADMIN_PASSWORD=<ADMIN_PASSWORD>
SEED_ADMIN_RESET_PASSWORD=false
# Only set this for a reviewed production seed. Leave false/absent normally.
SEED_ALLOW_PRODUCTION=false
SEED_NODE_1_NAME=mock-node-1
SEED_NODE_1_HOST=127.0.0.1
SEED_NODE_1_SSH_PORT=22
SEED_NODE_1_CPU_MILLICORES=2000
SEED_NODE_1_MEMORY_MB=2048
SEED_NODE_2_NAME=mock-node-2
SEED_NODE_2_HOST=127.0.0.1
SEED_NODE_2_SSH_PORT=22
SEED_NODE_2_CPU_MILLICORES=2000
SEED_NODE_2_MEMORY_MB=2048

# Traefik / Cloudflare placeholders. Verified values come from IAAS.
TRAEFIK_HOST=<SERVER1_PRIVATE_IP>
TRAEFIK_PORT=<VERIFIED_FREE_PORT>

# Runtime node access (worker). Key paths, never inline key material.
RUNTIME_NODE_SSH_USER=<DEPLOY_USER>
RUNTIME_NODE_SSH_KEY_PATH=<PATH_OUTSIDE_REPO>
