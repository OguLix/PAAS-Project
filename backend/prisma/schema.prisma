// OguLix PaaS schema.
// Source of truth for the model: docs/design/database-erd.md.
// Enum values for DeploymentStatus must match shared/types/deployment-status.ts.
// Do not run `prisma migrate` against a live database from an agent session.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  USER
  ADMIN
}

enum ApplicationStatus {
  ACTIVE
  ARCHIVED
}

enum NodeStatus {
  ONLINE
  DEGRADED
  OFFLINE
  MAINTENANCE
}

enum DeploymentStatus {
  QUEUED
  PREPARING
  BUILDING
  STARTING
  HEALTH_CHECKING
  RUNNING
  STOPPING
  STOPPED
  FAILED
  CANCELLED
}

enum DomainStatus {
  PENDING
  ACTIVE
  FAILED
  DISABLED
}

enum DeploymentLogLevel {
  INFO
  WARN
  ERROR
}

enum DeploymentLogStream {
  BUILD
  SYSTEM
}

model User {
  id           String   @id @default(uuid()) @db.VarChar(36)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  applications         Application[]
  sessions             Session[]
  requestedDeployments Deployment[]  @relation("DeploymentRequester")
  auditEvents          AuditEvent[]

  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.VarChar(36)
  userId     String    @map("user_id") @db.VarChar(36)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model Application {
  id               String            @id @default(uuid()) @db.VarChar(36)
  ownerId          String            @map("owner_id") @db.VarChar(36)
  name             String            @db.VarChar(120)
  sourceRepository String            @map("source_repository") @db.VarChar(2048)
  defaultBranch    String            @map("default_branch") @db.VarChar(255)
  dockerfilePath   String            @default("Dockerfile") @map("dockerfile_path") @db.VarChar(255)
  buildContext     String            @default(".") @map("build_context") @db.VarChar(255)
  internalPort     Int               @default(3000) @map("internal_port")
  healthCheckPath  String            @default("/") @map("health_check_path") @db.VarChar(255)
  cpuCores         Float             @default(0.5) @map("cpu_cores")
  memoryMb         Int               @default(512) @map("memory_mb")
  pidsLimit        Int               @default(100) @map("pids_limit")
  status           ApplicationStatus @default(ACTIVE)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  owner                User                  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  deployments          Deployment[]
  domains              Domain[]
  environmentVariables EnvironmentVariable[]

  @@index([ownerId, createdAt])
  @@map("applications")
}

model RuntimeNode {
  id                    String     @id @default(uuid()) @db.VarChar(36)
  name                  String     @unique @db.VarChar(64)
  host                  String     @db.VarChar(255)
  sshPort               Int        @default(22) @map("ssh_port")
  status                NodeStatus @default(OFFLINE)
  capacityCpuMillicores Int        @default(0) @map("capacity_cpu_millicores")
  capacityMemoryMb      Int        @default(0) @map("capacity_memory_mb")
  lastHeartbeatAt       DateTime?  @map("last_heartbeat_at")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  deployments Deployment[]

  @@index([status, lastHeartbeatAt])
  @@map("runtime_nodes")
}

model Deployment {
  id                 String           @id @default(uuid()) @db.VarChar(36)
  applicationId      String           @map("application_id") @db.VarChar(36)
  runtimeNodeId      String?          @map("runtime_node_id") @db.VarChar(36)
  status             DeploymentStatus @default(QUEUED)
  branch             String?          @db.VarChar(255)
  commitSha          String?          @map("commit_sha") @db.VarChar(64)
  imageReference     String?          @map("image_reference") @db.VarChar(512)
  imageDigest        String?          @map("image_digest") @db.VarChar(128)
  allocatedPort      Int?             @map("allocated_port")
  idempotencyKey     String?          @map("idempotency_key") @db.VarChar(128)
  requestFingerprint String?          @map("request_fingerprint") @db.VarChar(64)
  requestedByUserId  String?          @map("requested_by_user_id") @db.VarChar(36)
  errorCode          String?          @map("error_code") @db.VarChar(64)
  logLineCount       Int              @default(0) @map("log_line_count")
  logByteCount       Int              @default(0) @map("log_byte_count")
  startedAt          DateTime?        @map("started_at")
  finishedAt         DateTime?        @map("finished_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  application Application     @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  runtimeNode RuntimeNode?    @relation(fields: [runtimeNodeId], references: [id], onDelete: SetNull)
  requestedBy User?           @relation("DeploymentRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  logs        DeploymentLog[]

  @@unique([applicationId, idempotencyKey])
  @@unique([runtimeNodeId, allocatedPort])
  @@index([applicationId, createdAt])
  @@index([runtimeNodeId, status])
  @@index([status, createdAt])
  @@index([requestedByUserId, createdAt])
  @@map("deployments")
}

model DeploymentLog {
  id           String              @id @default(uuid()) @db.VarChar(36)
  deploymentId String              @map("deployment_id") @db.VarChar(36)
  sequence     Int
  level        DeploymentLogLevel  @default(INFO)
  stream       DeploymentLogStream @default(BUILD)
  message      String              @db.Text
  createdAt    DateTime            @default(now()) @map("created_at")

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@unique([deploymentId, sequence])
  @@index([deploymentId, createdAt])
  @@map("deployment_logs")
}

model Domain {
  id            String       @id @default(uuid()) @db.VarChar(36)
  applicationId String       @map("application_id") @db.VarChar(36)
  hostname      String       @unique @db.VarChar(253)
  isPrimary     Boolean      @default(false) @map("is_primary")
  status        DomainStatus @default(PENDING)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([applicationId])
  @@map("domains")
}

model EnvironmentVariable {
  id             String   @id @default(uuid()) @db.VarChar(36)
  applicationId  String   @map("application_id") @db.VarChar(36)
  key            String   @db.VarChar(128)
  encryptedValue String   @map("encrypted_value") @db.Text
  isSecret       Boolean  @default(true) @map("is_secret")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, key])
  @@map("environment_variables")
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.VarChar(36)
  actorUserId  String?  @map("actor_user_id") @db.VarChar(36)
  action       String   @db.VarChar(64)
  resourceType String   @map("resource_type") @db.VarChar(64)
  resourceId   String?  @map("resource_id") @db.VarChar(64)
  requestId    String   @map("request_id") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_events")
}
